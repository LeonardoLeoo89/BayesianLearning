network "AllergyCrossReactivity" {
// written by aGrUM 2.3.2
}

variable Atopy {
   type discrete[2] {No, Yes};
}

variable DustMiteAllergy {
   type discrete[2] {No, Yes};
}

variable PollenAllergy {
   type discrete[2] {No, Yes};
}

variable BirchPollenAllergy {
   type discrete[2] {No, Yes};
}

variable AppleAllergy {
   type discrete[2] {No, Yes};
}

variable HazelnutAllergy {
   type discrete[2] {No, Yes};
}

variable Asthma {
   type discrete[2] {No, Yes};
}

variable AllergicRhinitis {
   type discrete[2] {No, Yes};
}

probability (Atopy) {
   table 0.75 0.25;
}
probability (DustMiteAllergy | Atopy) {
   (No) 0.9 0.1;
   (Yes) 0.4 0.6;
}
probability (PollenAllergy | Atopy) {
   (No) 0.85 0.15;
   (Yes) 0.3 0.7;
}
probability (BirchPollenAllergy | PollenAllergy) {
   (No) 0.98 0.02;
   (Yes) 0.6 0.4;
}
probability (AppleAllergy | BirchPollenAllergy) {
   (No) 0.98 0.02;
   (Yes) 0.5 0.5;
}
probability (HazelnutAllergy | BirchPollenAllergy) {
   (No) 0.99 0.01;
   (Yes) 0.7 0.3;
}
probability (Asthma | DustMiteAllergy) {
   (No) 0.95 0.05;
   (Yes) 0.5 0.5;
}
probability (AllergicRhinitis | PollenAllergy) {
   (No) 0.95 0.05;
   (Yes) 0.2 0.8;
}

