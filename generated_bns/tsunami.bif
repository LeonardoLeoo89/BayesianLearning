network "TsunamiRisk" {
// written by aGrUM 2.3.2
}

variable SubmarineEarthquake {
   type discrete[2] {False, True};
}

variable CoastalLandslide {
   type discrete[2] {False, True};
}

variable Tsunami {
   type discrete[2] {False, True};
}

variable TsunamiWarning {
   type discrete[2] {Inactive, Active};
}

probability (SubmarineEarthquake) {
   table 0.99 0.01;
}
probability (CoastalLandslide) {
   table 0.98 0.02;
}
probability (Tsunami | SubmarineEarthquake, CoastalLandslide) {
   (False, False) 0.999 0.001;
   (True, False) 0.2 0.8;
   (False, True) 0.3 0.7;
   (True, True) 0.05 0.95;
}
probability (TsunamiWarning | Tsunami, SubmarineEarthquake) {
   (False, False) 0.99 0.01;
   (True, False) 0.05 0.95;
   (False, True) 0.1 0.9;
   (True, True) 0.01 0.99;
}

